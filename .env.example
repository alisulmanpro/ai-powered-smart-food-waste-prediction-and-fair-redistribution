# Copy to .env  (npm run setup does this for you). Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=foodwaste
POSTGRES_PASSWORD=foodwaste
POSTGRES_DB=foodwaste
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
# Use a long random value in production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-dot-env-use-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# First admin, created automatically on first start (change the password!)
FIRST_ADMIN_NAME=Admin
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=admin12345
OSRM_BASE_URL=https://router.project-osrm.org

# --- Admin panel ---
ADMIN_PORT=5173
VITE_API_URL=http://localhost:8000
